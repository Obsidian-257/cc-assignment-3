<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project_title }}</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            font-family: Arial, sans-serif;
            color: #0f172a;
        }
        .container {
            max-width: 650px;
            margin: 20px;
            padding: 45px;
            background: white;
            border-radius: 14px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.08);
        }
        h1 { margin-top: 0; }
        .status {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            background: #dcfce7;
            color: #166534;
            font-weight: bold;
            font-size: 13px;
        }
        .details {
            margin-top: 30px;
            padding: 20px;
            background: #f8fafc;
            border-radius: 10px;
        }
        .details p { margin: 10px 0; }
    </style>
</head>
<body>
    <main class="container">
        <span class="status">SERVER ONLINE</span>
        <h1>{{ project_title }}</h1>
        <p>{{ project_description }}</p>
        <div class="details">
            <h3>Infrastructure information</h3>
            <p><strong>Operating system:</strong> {{ ansible_facts['distribution'] }}</p>
            <p><strong>Hostname:</strong> {{ ansible_facts['hostname'] }}</p>
            <p><strong>Web server:</strong> Nginx</p>
            <p><strong>Configuration:</strong> Ansible</p>
            <p><strong>Infrastructure:</strong> Terraform</p>
        </div>
        <p>
            This website was automatically deployed
            and configured using Infrastructure as Code.
        </p>
    </main>
</body>
</html>
